<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>match_mur_gui</name>
  <version>0.0.0</version>
  <description>Reusable PyQt GUI components and a general control GUI for MuR robots.</description>
  <maintainer email="Recker@match.uni-hannover.de">rosmatch</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>qtbase5-dev</build_depend>
  <build_depend>qtdeclarative5-dev</build_depend>
  <depend>controller_manager_msgs</depend>
  <depend>ur_dashboard_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <build_depend>actionlib_msgs</build_depend>
  <depend>rosgraph_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>ament_index_cpp</depend>

  <depend>action_msgs</depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>ewellix_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <depend>mir_srvs</depend>
  <exec_depend>mur_control</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>qml-module-qtquick-controls2</exec_depend>
  <exec_depend>qml-module-qtquick-dialogs</exec_depend>
  <exec_depend>qml-module-qtquick-layouts</exec_depend>
  <exec_depend>qmlscene</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_msgs</depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>trajectory_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
